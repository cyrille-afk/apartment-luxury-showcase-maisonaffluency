{
  "schema_version": 1,
  "events": {
    "project.client_link_copied": {
      "event_schema_version": 1,
      "description": "A quote or guest payment link was successfully written to the clipboard, including automatic copying after creation.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link_type"
        ],
        "properties": {
          "link_type": {
            "type": "string",
            "enum": [
              "quote",
              "guest_payment"
            ]
          }
        }
      }
    },
    "project.client_link_sent": {
      "event_schema_version": 1,
      "description": "The existing client quote/payment email sender confirmed a successful email send containing a guest payment link; never fires for a clipboard copy or mail composer.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link_type",
          "channel"
        ],
        "properties": {
          "link_type": {
            "type": "string",
            "enum": [
              "guest_payment"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "email"
            ]
          }
        }
      }
    },
    "project.copilot_dimension_selected": {
      "event_schema_version": 1,
      "description": "The user changed the size/dimension option on a Trade product page.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          }
        }
      }
    },
    "project.copilot_finish_selected": {
      "event_schema_version": 1,
      "description": "The user changed a finish (fabric, wood, base, top or material) on a Trade product page.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "has_fabric": {
            "type": "boolean"
          },
          "has_wood": {
            "type": "boolean"
          },
          "has_base": {
            "type": "boolean"
          },
          "has_top": {
            "type": "boolean"
          }
        }
      }
    },
    "project.copilot_product_selected": {
      "event_schema_version": 1,
      "description": "A Trade product page opened in the Co-Pilot flow.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          }
        }
      }
    },
    "project.copilot_quote_line_failed": {
      "event_schema_version": 1,
      "description": "An Add to Co-Pilot attempt did not persist; stage says where it failed.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "stage"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "create_quote",
              "add",
              "verify",
              "unexpected"
            ]
          }
        }
      }
    },
    "project.copilot_quote_line_saved": {
      "event_schema_version": 1,
      "description": "An Add to Co-Pilot line was confirmed stored on the quote.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "quantity"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "project.directory_letter_selected": {
      "event_schema_version": 1,
      "description": "A visitor selects a letter on the directory A–Z ribbon.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "letter",
          "surface"
        ],
        "properties": {
          "letter": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "surface": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          }
        }
      }
    },
    "project.directory_modal_dismissed": {
      "event_schema_version": 1,
      "description": "A visitor dismisses the directory modal using Escape, an outside click or its close button; fires once per dismissal.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "surface"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "escape",
              "outside",
              "close_button"
            ]
          },
          "surface": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          }
        }
      }
    },
    "project.directory_search_changed": {
      "event_schema_version": 2,
      "description": "A visitor edits a nonempty directory search; records bounded catalogue matches, counts and match category, never typed text.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "character_count",
          "result_count",
          "surface"
        ],
        "properties": {
          "character_count": {
            "type": "integer",
            "minimum": 1
          },
          "result_count": {
            "type": "integer",
            "minimum": 0
          },
          "surface": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "match_kind": {
            "type": "string",
            "enum": [
              "empty",
              "exact_designer",
              "partial_designer",
              "unmatched"
            ]
          },
          "canonical_designer": {
            "type": "string"
          },
          "matched_designers": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "project.directory_search_refined": {
      "event_schema_version": 1,
      "description": "A visitor starts, extends, shortens, replaces or clears a directory search, or switches to an initial; stores catalogue matches only.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refinement",
          "result_count",
          "surface",
          "match_kind",
          "canonical_designer",
          "matched_designers"
        ],
        "properties": {
          "refinement": {
            "type": "string",
            "enum": [
              "initial",
              "extend",
              "shorten",
              "replace",
              "clear",
              "letter"
            ]
          },
          "letter": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "result_count": {
            "type": "integer",
            "minimum": 0
          },
          "surface": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "match_kind": {
            "type": "string",
            "enum": [
              "empty",
              "exact_designer",
              "partial_designer",
              "unmatched"
            ]
          },
          "canonical_designer": {
            "type": "string"
          },
          "matched_designers": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "project.directory_search_result_selected": {
      "event_schema_version": 1,
      "description": "A searched directory result is selected after its profile data loads; join the selection to a subsequent native profile page view to measure outcomes, not proven relevance.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "designer_slug",
          "result_count",
          "surface",
          "match_kind",
          "canonical_designer",
          "matched_designers"
        ],
        "properties": {
          "designer_slug": {
            "type": "string"
          },
          "result_count": {
            "type": "integer",
            "minimum": 0
          },
          "surface": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "match_kind": {
            "type": "string",
            "enum": [
              "empty",
              "exact_designer",
              "partial_designer",
              "unmatched"
            ]
          },
          "canonical_designer": {
            "type": "string"
          },
          "matched_designers": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "project.onboarding_tour_completed": {
      "event_schema_version": 1,
      "description": "The member explicitly finishes the onboarding walkthrough; closing or skipping its last card is not a completion.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tour",
          "step_id",
          "step_number",
          "total_steps"
        ],
        "properties": {
          "tour": {
            "type": "string",
            "enum": [
              "felix",
              "quick"
            ]
          },
          "step_id": {
            "type": "string",
            "maxLength": 80
          },
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "total_steps": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "project.onboarding_tour_exited": {
      "event_schema_version": 1,
      "description": "An active onboarding run is explicitly dismissed or the document exits; page-exit delivery is best effort, never emitted for ordinary route navigation or effect cleanup.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tour",
          "step_id",
          "step_number",
          "total_steps",
          "reason"
        ],
        "properties": {
          "tour": {
            "type": "string",
            "enum": [
              "felix",
              "quick"
            ]
          },
          "step_id": {
            "type": "string",
            "maxLength": 80
          },
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "total_steps": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "enum": [
              "dismissed",
              "page_exit"
            ]
          }
        }
      }
    },
    "project.onboarding_tour_replayed": {
      "event_schema_version": 1,
      "description": "The existing Replay Onboarding Tour action resets completion/progress and requests a new walkthrough from step one.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tour"
        ],
        "properties": {
          "tour": {
            "type": "string",
            "enum": [
              "felix",
              "quick"
            ]
          }
        }
      }
    },
    "project.onboarding_tour_started": {
      "event_schema_version": 1,
      "description": "A desktop onboarding walkthrough opens, distinguishing manual launch, automatic start, and resumed progress.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tour",
          "mode",
          "total_steps"
        ],
        "properties": {
          "tour": {
            "type": "string",
            "enum": [
              "felix",
              "quick"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "manual",
              "automatic",
              "resumed"
            ]
          },
          "total_steps": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "project.onboarding_tour_step_viewed": {
      "event_schema_version": 1,
      "description": "A walkthrough card is actually revealed on its destination page, once per step per run; last observed step supports drop-off funnels even without an exit event.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tour",
          "step_id",
          "step_number",
          "total_steps",
          "target_available"
        ],
        "properties": {
          "tour": {
            "type": "string",
            "enum": [
              "felix",
              "quick"
            ]
          },
          "step_id": {
            "type": "string",
            "maxLength": 80
          },
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "total_steps": {
            "type": "integer",
            "minimum": 1
          },
          "target_available": {
            "type": "boolean"
          }
        }
      }
    },
    "project.order_paid": {
      "event_schema_version": 2,
      "description": "An order was paid: Stripe confirmed a card/PayNow/wallet checkout, or an admin marked a bank-transfer order paid (source=admin_marked).",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_value_cents",
          "charged_cents",
          "currency",
          "method",
          "is_deposit",
          "payment_status"
        ],
        "properties": {
          "order_value_cents": {
            "type": "number"
          },
          "charged_cents": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "card",
              "paynow",
              "wallet",
              "bank_transfer"
            ]
          },
          "is_deposit": {
            "type": "boolean"
          },
          "payment_status": {
            "type": "string",
            "enum": [
              "succeeded",
              "processing"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "checkout",
              "admin_marked"
            ]
          }
        }
      }
    },
    "project.quote_editable_revision_created": {
      "event_schema_version": 1,
      "description": "An administrator creates a new editable revision; revisiting an existing revision does not count as creation.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "admin_quotes",
              "quote_builder"
            ]
          }
        }
      }
    },
    "project.quote_opened": {
      "event_schema_version": 1,
      "description": "Quote opens: a valid shared quote successfully loaded in the browser. Counts successful quote access only, not preview impressions, clicks or metadata crawler requests; no client, quote, URL or token properties.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.quote_pricing_saved": {
      "event_schema_version": 1,
      "description": "Admin pricing successfully committed, before email dispatch; includes initial pricing and updates.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "line_count",
          "pricing_update"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "admin_quotes"
            ]
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          },
          "pricing_update": {
            "type": "boolean"
          }
        }
      }
    },
    "project.quote_revision_requested": {
      "event_schema_version": 1,
      "description": "An administrator's confirmed revision request succeeds in Quote Management or Quote Builder; canceled or failed requests are excluded.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "has_reason"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "admin_quotes",
              "quote_builder"
            ]
          },
          "has_reason": {
            "type": "boolean"
          }
        }
      }
    },
    "project.seating_dropdown_opened": {
      "event_schema_version": 1,
      "description": "The Seating navigation dropdown opens, excluding repeated trigger interactions while already open.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.seating_featured_image_interacted": {
      "event_schema_version": 1,
      "description": "A featured Seating image card is hovered or clicked, including its caption.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subcategory",
          "interaction",
          "image_index"
        ],
        "properties": {
          "subcategory": {
            "type": "string",
            "enum": [
              "Armchairs",
              "Bar Stools",
              "Chairs",
              "Daybeds & Benches",
              "Ottomans & Stools",
              "Sofas"
            ]
          },
          "interaction": {
            "type": "string",
            "enum": [
              "hover",
              "click"
            ]
          },
          "image_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        }
      }
    },
    "project.seating_subcategory_clicked": {
      "event_schema_version": 1,
      "description": "A Seating dropdown text-sidebar subcategory is selected.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subcategory"
        ],
        "properties": {
          "subcategory": {
            "type": "string",
            "enum": [
              "Armchairs",
              "Bar Stools",
              "Chairs",
              "Daybeds & Benches",
              "Ottomans & Stools",
              "Sofas"
            ]
          }
        }
      }
    }
  }
}
