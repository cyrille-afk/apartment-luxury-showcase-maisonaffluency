{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.maisonaffluency.com" }],
      "destination": "https://maisonaffluency.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(?<preview>.*)\\.lovable\\.app" }],
      "destination": "https://maisonaffluency.com/:path*",
      "permanent": true
    },
    { "source": "/products/:path*", "destination": "https://maisonaffluency.com/designers", "permanent": true },
    { "source": "/products", "destination": "https://maisonaffluency.com/designers", "permanent": true },
    { "source": "/shop/:path*", "destination": "https://maisonaffluency.com/designers", "permanent": true },
    { "source": "/shop", "destination": "https://maisonaffluency.com/designers", "permanent": true },
    { "source": "/catalog/:path*", "destination": "https://maisonaffluency.com/designers", "permanent": true },
    { "source": "/catalog", "destination": "https://maisonaffluency.com/designers", "permanent": true },
    { "source": "/catalogue/:path*", "destination": "https://maisonaffluency.com/designers", "permanent": true },
    { "source": "/catalogue", "destination": "https://maisonaffluency.com/designers", "permanent": true },
    { "source": "/collection/:path*", "destination": "https://maisonaffluency.com/designers", "permanent": true },
    { "source": "/collection", "destination": "https://maisonaffluency.com/designers", "permanent": true },
    { "source": "/home", "destination": "https://maisonaffluency.com/", "permanent": true },
    { "source": "/index.php", "destination": "https://maisonaffluency.com/", "permanent": true },
    { "source": "/test/:path*", "destination": "https://maisonaffluency.com/", "permanent": true },
    { "source": "/test", "destination": "https://maisonaffluency.com/", "permanent": true },
    { "source": "/preview/:path*", "destination": "https://maisonaffluency.com/", "permanent": true },
    { "source": "/preview", "destination": "https://maisonaffluency.com/", "permanent": true },
    { "source": "/staging/:path*", "destination": "https://maisonaffluency.com/", "permanent": true },
    { "source": "/staging", "destination": "https://maisonaffluency.com/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/designers", "destination": "/index.html" },
    { "source": "/designers/:path*", "destination": "/index.html" },
    { "source": "/designer/:path*", "destination": "/index.html" },
    { "source": "/product/:path*", "destination": "/index.html" },
    { "source": "/products-category/:path*", "destination": "/index.html" },
    { "source": "/journal", "destination": "/index.html" },
    { "source": "/journal/:path*", "destination": "/index.html" },
    { "source": "/studios", "destination": "/index.html" },
    { "source": "/studios/:path*", "destination": "/index.html" },
    { "source": "/gallery", "destination": "/index.html" },
    { "source": "/new-in", "destination": "/index.html" },
    { "source": "/apartment-tour", "destination": "/index.html" },
    { "source": "/trade-program", "destination": "/index.html" },
    { "source": "/trade", "destination": "/index.html" },
    { "source": "/trade/:path*", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/unsubscribe", "destination": "/index.html" },
    { "source": "/auth", "destination": "/index.html" },
    { "source": "/auth/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
